<div class="container">
    <div class="row g-4 justify-content-center">

        <% projects.forEach(project => { %>

            <div class="col-12 col-md-6 col-lg-4 d-flex">

                <div class="project-card h-100 d-flex flex-column reveal">

                    <img
                        src="<%= project.image %>"
                        alt="<%= project.name %>"
                    >

                    <div class="project-content text-center d-flex flex-column flex-grow-1">

                        <h3><%= project.name %></h3>

                        <p><%= project.description %></p>

                        <div class="mt-auto">
                            <a href="#" class="btn btn-outline-light">
                                View Project
                            </a>
                        </div>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>
</div>